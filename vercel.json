{
  "version": 2,
  "buildCommand": "pnpm --filter @workspace/how-its-built run build",
  "outputDirectory": "artifacts/how-its-built/dist/public",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "framework": "vite",
  "env": {
    "PORT": "5173",
    "BASE_PATH": "/"
  },
  "build": {
    "env": {
      "PORT": "5173",
      "BASE_PATH": "/"
    }
  },
  "functions": {
    "artifacts/how-its-built/api/docs-agent/*.ts": {
      "maxDuration": 300
    },
    "artifacts/how-its-built/api/chat.ts": {
      "maxDuration": 60
    },
    "artifacts/how-its-built/api/mstp-chat.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/docs-agent/:agent", "destination": "/api/docs-agent?agent=:agent" },
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/(.*)",       "destination": "/index.html"  }
  ]
}