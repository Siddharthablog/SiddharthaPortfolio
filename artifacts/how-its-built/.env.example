# Port for local development
PORT=5173

# Base path for the application (use / for root)
BASE_PATH=/

# ── API keys (required for the chatbots to work locally) ──────────────────────
# Groq API key — powers the portfolio AI assistant (ChatWidget)
# Get one free at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Hugging Face token — powers the MSTP fine-tune chatbot
# Get one at https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# OpenRouter API key — powers the DocOps Agent Suite (4 AI documentation agents)
# Get one free at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
